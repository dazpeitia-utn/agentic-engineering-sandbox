# Copiá este archivo a `.env` en la raíz del monorepo y completá tus claves.
OPENAI_API_KEY=

# Opcional: modelo de los agentes (default gpt-4o)
# OPENAI_MODEL=gpt-4o

# Opcional: pasar los agentes por el proxy de guardrails (proyecto 07)
# OPENAI_BASE_URL=http://127.0.0.1:8787/v1

# Opcional: proveedor de los agentes (proyecto 16): openai | anthropic | ollama | router
# LLM_PROVIDER=openai
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OLLAMA_MODEL=llama3.1
